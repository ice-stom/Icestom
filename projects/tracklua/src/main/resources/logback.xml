<configuration debug="true">
    <!-- INFO: no highlight -->
    <appender name="CONSOLE_INFO" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%class{0}) - %msg${line.separator}%ex</pattern>
        </encoder>
    </appender>

    <!-- Everything else: highlighted -->
    <appender name="CONSOLE_OTHER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%class{0}) - %highlight(%msg)${line.separator}%highlight(%ex)</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_INFO"/>
        <appender-ref ref="CONSOLE_OTHER"/>
    </root>
</configuration>